{{#if flash.length}}
  <div class="flash-stack">
    {{#each flash}}
      <div class="flash flash--{{type}}" role="alert">
        <span class="flash__dot"></span>
        <p>{{message}}</p>
        <button type="button" class="flash__close" data-dismiss-flash aria-label="Fechar">&times;</button>
      </div>
    {{/each}}
  </div>
{{/if}}

# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Aplicacao
NODE_ENV=production
PORT=3000
# URL publica onde o sistema vai responder (SEM barra no final).
# E essa URL que entra dentro do QR Code: APP_URL/r/CODIGO
APP_URL=https://seudominio.com.br
APP_NAME=Plaquinhas QR

# Sessao
# Gere uma string aleatoria longa: openssl rand -hex 32
SESSION_SECRET=troque-esta-string-por-uma-chave-aleatoria-bem-longa
SESSION_MAX_AGE_HOURS=72

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=plaquinhas
DB_PASSWORD=
DB_NAME=plaquinhas
DB_CONNECTION_LIMIT=10

# Usuario administrador criado pelo comando `npm run db:setup`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=DefinaUmaSenhaForteAqui

# Padroes de geracao dos QR Codes
QR_DEFAULT_SIZE_CM=5
QR_DEFAULT_COLOR=#000000
# L = 7%, M = 15%, Q = 25%, H = 30% de redundancia (H e o mais resistente)
QR_ERROR_CORRECTION_LEVEL=H
# Zona de silencio (borda branca) em modulos. 2 a 4 e o recomendado.
QR_MARGIN=2
